:c_13 a owl:NamedIndividual,
        tido:Consideration ;
    rdf:value "For every means you would like to deploy, it is important to put your thoughts on paper as not only Ton, but also the minister and everyone else involved in the safeguard ladder to know what is going on in your head"^^xsd:string ;
