:evaluation_17 a owl:NamedIndividual,
        tido:Activity,
        tido:Evaluation ;
    rdfs:label "De_Dienst_ep_1_seg_97"^^xsd:string ;
    rdf:value " ... because for the same money ... ... you know, other teams have kept an eye on him for years ... ... have kept an eye on him for years ... ... and of course it is also very human ... ... to think further and look further ... ... you know, it happens to me more often ... ... and of course those are the interesting discussions ... ... that sometimes a contractor comes to me ... ... and he says, well, I want to do this and that ... ... and then I say, sorry, I understand that you want it ..."@en,
        " Want voor hetzelfde geld hebben andere teams al jaren in de gaten gehouden. En het is ook heel menselijk om gelijk verder te denken en verder te kijken. Het gebeurt bij mij ook wel vaker. Dat zijn natuurlijk de interessante discussies. Dat soms een bewerker bij me komt en die zegt, ik wil dat, dat en dat doen. En dan zeg ik, ja sorry, ik begrijp dat je het wil, maar het mag gewoon niet."@nl ;
    prov:endedAtTime "2025-01-01T00:26:46"^^xsd:dateTime ;
    prov:startedAtTime "2025-01-01T00:26:27"^^xsd:dateTime ;
