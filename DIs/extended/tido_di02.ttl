:evaluation_13 a owl:NamedIndividual,
        tido:Activity,
        tido:Evaluation ;
    rdfs:label "De_Dienst_ep_1_seg_92"^^xsd:string ;
    rdf:value " ... so listen and follow ... ... I seem to have overdone something ... ... but my hands are busy doing a round of social media ... ... to see what kind of person this is ... ... can I just do that?"@en,
        " Dus afluisteren en achtervolgen lijken me iets wat overdreven. Maar mijn handen jeuken om een rondje social media te doen om te zien wat voor een persoon dit is. Mag ik dat gewoon doen?"@nl ;
