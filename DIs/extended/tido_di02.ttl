    tido:supports :c_17 .

:c_14 a owl:NamedIndividual,
        tido:Consideration ;
    rdf:value "You must always ask yourself whether if that what you want to do is necessary, whether it is proportional (i.e. how does the impact of the means relate to the threat of the situation), and whether it is subsidiary (i.e. could you achieve the same with a lighter means)."^^xsd:string ;
    prov:wasGeneratedBy :evaluation_16 ;
    tido:supports :c_17 .

