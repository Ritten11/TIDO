:activity_1 a owl:NamedIndividual,
        tido:Activity ;
    rdfs:label "De_Dienst_ep_1_seg_47"^^xsd:string ;
    rdf:value " And the CT team is a counter-terrorism team. It is a message from the country."@en,
        " En het CT-team, dat is een contraterrorisme-team. Het is een melding vanuit het land."@nl ;
