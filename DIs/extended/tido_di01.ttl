    rdfs:label "De_Dienst_ep_1_seg_49"^^xsd:string ;
    rdf:value " I have a signature book."@en,
        " Ik heb een aantekeningenboekje nodig."@nl ;
    prov:endedAtTime "2025-01-01T00:16:23"^^xsd:dateTime ;
