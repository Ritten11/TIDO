@prefix : <https://w3id.org/tido/di01#> .
@prefix mod: <https://w3id.org/mod#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tido: <https://w3id.org/tido#> .
@prefix tido_case: <https://w3id.org/tido/case#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rdf:label a owl:DatatypeProperty ;
    rdfs:label "label" .

rdf:value a owl:DatatypeProperty ;
    rdfs:label "value" .

rdfs:label a owl:AnnotationProperty ;
    rdfs:label "label" .

prov:hadPrimarySource a owl:ObjectProperty ;
    rdfs:label "had primary source" .

prov:wasAttributedTo a owl:ObjectProperty ;
    rdfs:label "was attributed to" .

prov:wasGeneratedBy a owl:ObjectProperty ;
    rdfs:label "was generated by" .

prov:wasInformedBy a owl:ObjectProperty ;
    rdfs:label "was informed by" .

tido:answers a owl:ObjectProperty ;
    rdfs:label "answers" .

tido:disputes a owl:ObjectProperty ;
    rdfs:label "disputes" .

tido:supports a owl:ObjectProperty ;
    rdfs:label "supports" .

tido:wasRecalledBy a owl:ObjectProperty ;
    rdfs:label "was recalled by" .

tido:wasSelectedBy a owl:ObjectProperty ;
    rdfs:label "was selected by" .

: a owl:Ontology ;
    mod:createdWith <https://chowlk.linkeddata.es/> .

:c_1 a owl:NamedIndividual ;
    rdf:value "If you are following a degree in chemical engineering, you might just be interested in those kind of things"^^xsd:string ;
    prov:wasGeneratedBy :evaluation_2 ;
    tido:disputes :h_2 .

:c_2 a owl:NamedIndividual,
        tido:Consideration ;
    rdf:value "It is also weird that someone is orienting himself to build a bomb"^^xsd:string ;
    prov:wasGeneratedBy :evaluation_3 ;
    tido:supports :h_2 .

:e_1 a owl:NamedIndividual,
        tido:Evidence ;
    rdf:value "A report was received by the AIVD front-office"^^xsd:string ;
    prov:hadPrimarySource tido_case:report ;
    tido:wasRecalledBy :orientation_1 .

:e_2 a owl:NamedIndividual,
        tido:Evidence ;
    rdf:value "This report was sent to the counter terrorism team"^^xsd:string ;
    prov:hadPrimarySource tido_case:report ;
    tido:wasRecalledBy :orientation_1 .

:e_3 a owl:NamedIndividual,
        tido:Evidence ;
    rdf:value "The report originates from a concerned citizen"^^xsd:string ;
    prov:hadPrimarySource tido_case:report ;
    tido:supports :h_2 ;
    tido:wasRecalledBy :orientation_2 .

:e_4 a owl:NamedIndividual,
        tido:Evidence ;
    rdf:value "The concerned citizen is a teacher"^^xsd:string ;
    prov:hadPrimarySource tido_case:report ;
    tido:wasRecalledBy :orientation_2 .

:e_5 a owl:NamedIndividual,
        tido:Evidence ;
    rdf:value "The concerned citizen wishes to remain anonymous, but it is possible to deduce who it is if needed"^^xsd:string ;
    prov:hadPrimarySource tido_case:report ;
    tido:wasRecalledBy :orientation_3 .

:e_6 a owl:NamedIndividual,
        tido:Evidence ;
    rdf:value "The concerned citizen teaches chemical engineering"^^xsd:string ;
    prov:hadPrimarySource tido_case:report ;
    tido:supports :h_2 ;
    tido:wasRecalledBy :orientation_3 .

:e_7 a owl:NamedIndividual,
        tido:Evidence ;
    rdf:value "During a practical, the concerned citizen noticed that one of his students was asking many questions about substances that could be used to create an explosive"^^xsd:string ;
    prov:hadPrimarySource tido_case:report ;
    tido:supports :h_2 ;
    tido:wasRecalledBy :orientation_3 .

:e_8 a owl:NamedIndividual,
        tido:Evidence ;
    rdf:value "The name of the student is Sander van der Land"^^xsd:string ;
    prov:hadPrimarySource tido_case:report ;
    tido:wasRecalledBy :orientation_3 .

:h_1 a owl:NamedIndividual,
        tido:Hypothesis ;
    rdf:value "At the moment, the information means nothing"^^xsd:string ;
    prov:wasGeneratedBy :evaluation_1 .

:rq_1 a owl:NamedIndividual,
        tido:RQ ;
    rdf:value "What are we going to do with this information?"^^xsd:string ;
    prov:wasGeneratedBy :evaluation_1 .

prov:Entity a owl:Class ;
    rdfs:label "Entity" .

tido:Agent a owl:Class ;
    rdfs:label "Agent" .

tido:Consideration a owl:Class ;
    rdfs:label "Consideration" .

tido:Option a owl:Class ;
    rdfs:label "Option" .

tido:Resolution a owl:Class ;
    rdfs:label "Resolution" .

tido_case:citizen a owl:NamedIndividual,
        tido:Agent ;
    rdfs:label "concerned citizen"^^xsd:string .

:activity_1 a owl:NamedIndividual,
        tido:Activity ;
    rdfs:label "De_Dienst_ep_1_seg_47"^^xsd:string ;
    prov:wasInformedBy :orientation_1 .

:activity_2 a owl:NamedIndividual,
        tido:Activity ;
    rdfs:label "De_Dienst_ep_1_seg_49"^^xsd:string ;
    prov:wasInformedBy :orientation_2 .

:rq_2 a owl:NamedIndividual,
        tido:RQ ;
    rdf:value "Should we be concerned?"^^xsd:string ;
    prov:wasGeneratedBy :evaluation_4 .

tido:Activity a owl:Class ;
    rdfs:label "Activity" .

tido:Hypothesis a owl:Class ;
    rdfs:label "Hypothesis" .

tido:RQ a owl:Class ;
    rdfs:label "R Q" .

:evaluation_2 a owl:NamedIndividual,
        tido:Evaluation ;
    rdfs:label "De_Dienst_ep_1_seg_52"^^xsd:string ;
    prov:wasInformedBy :evaluation_1 .

:evaluation_3 a owl:NamedIndividual,
        tido:Evaluation ;
    rdfs:label "De_Dienst_ep_1_seg_53"^^xsd:string ;
    prov:wasInformedBy :evaluation_2 .

:evaluation_4 a owl:NamedIndividual,
        tido:Evaluation ;
    rdfs:label "De_Dienst_ep_1_seg_54"^^xsd:string ;
    prov:wasInformedBy :evaluation_3 .

:mixed_5 a owl:NamedIndividual,
        tido:Evaluation,
        tido:Resolution ;
    rdfs:label "De_Dienst_ep_1_seg_55"^^xsd:string ;
    prov:wasInformedBy :evaluation_4 .

tido:Orientation a owl:Class ;
    rdfs:label "Orientation" .

:evaluation_1 a owl:NamedIndividual,
        tido:Evaluation ;
    rdfs:label "De_Dienst_ep_1_seg_51"^^xsd:string ;
    prov:wasInformedBy :orientation_3 .

:orientation_1 a owl:NamedIndividual,
        tido:Orientation ;
    rdfs:label "De_Dienst_ep_1_seg_46"^^xsd:string .

:orientation_2 a owl:NamedIndividual,
        tido:Orientation ;
    rdfs:label "De_Dienst_ep_1_seg_48"^^xsd:string ;
    prov:wasInformedBy :activity_1 .

tido:Evaluation a owl:Class ;
    rdfs:label "Evaluation" .

:h_2 a owl:NamedIndividual,
        tido:Hypothesis,
        tido:Option ;
    rdf:value "This situation could eventually lead to a cause of concern"^^xsd:string ;
    prov:wasGeneratedBy :mixed_5 ;
    tido:answers :rq_2 ;
    tido:wasSelectedBy :mixed_5 .

:orientation_3 a owl:NamedIndividual,
        tido:Orientation ;
    rdfs:label "De_Dienst_ep_1_seg_50"^^xsd:string ;
    prov:wasInformedBy :activity_2 .

tido:Evidence a owl:Class ;
    rdfs:label "Evidence" .

tido_case:report a owl:NamedIndividual,
        prov:Entity ;
    rdf:label "report front-office"^^xsd:string ;
    prov:wasAttributedTo tido_case:citizen .

